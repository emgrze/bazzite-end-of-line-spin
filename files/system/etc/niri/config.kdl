// End of Line — Niri default config
// Cyan neon aesthetic. Minimal starting point.
// Users can override in ~/.config/niri/config.kdl

// Input
input {
    keyboard {
        xkb {
            layout "pl"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

// Outputs — leave empty for auto
// output "eDP-1" {
//     scale 1.0
// }

// Layout
layout {
    gaps 8
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 2
        active-color "#00F0FF"
        inactive-color "#1a3a4a"
    }
    border {
        width 2
        active-color "#00F0FF"
        inactive-color "#0a1a24"
        // sharp corners for the cyber look
    }
}

// Animations
animations {
    horizontal-view-movement {
        spring damping-ratio=0.8 stiffness=800 epsilon=0.0001
    }
}

// Window rules
window-rule {
    match app-id="brave-origin"
    open-maximized true
}

window-rule {
    match app-id="brave-browser"
    open-maximized true
}

// Key bindings
binds {
    // Terminal
    Mod+Return { spawn "alacritty"; }
    Mod+Shift+Return { spawn "alacritty"; }

    // Launcher / overview (Noctalia)
    // Dostosuj komendę do tego, jak Noctalia jest uruchamiane w twojej wersji
    Mod+D { spawn "noctalia-shell"; }
    // Alternatywy, które mogą być potrzebne w zależności od pakietu:
    // Mod+D { spawn "qs" "-c" "noctalia"; }
    // Mod+D { spawn "noctalia"; }

    // Window management
    Mod+Q { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // Focus
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    // Move
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // Screenshot / power
    Mod+Shift+S { screenshot; }
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }

    // Volume / brightness (media keys)
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        { spawn "wpctl" "set-mute"   "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp  { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }
}

// Spawn at startup
spawn-at-startup "swww-daemon"
spawn-at-startup "noctalia-shell"
// spawn-at-startup "mako"
// spawn-at-startup "wlsunset" "-l" "52.2" "-L" "21.0"   # Warszawa
